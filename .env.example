# Copy to .env.local and fill in. Never commit real keys.
# Without ELEVENLABS_API_KEY the app runs in labelled fallback mode.
ELEVENLABS_API_KEY=

# Optional TTS overrides
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# ELEVENLABS_TTS_MODEL=eleven_flash_v2_5

# Optional semantic extraction through ElevenLabs Agents (text-only).
# Create the agent once with: npm run setup:reasoning-agent
# ELEVENLABS_REASONING_AGENT_ID=

# LLM used by the setup script when creating the agent (default gemini-2.5-flash)
# ELEVENLABS_REASONING_LLM=gemini-2.5-flash

# Set to off to force the deterministic phrase matcher
# SECONDSHIFT_SEMANTIC=off
